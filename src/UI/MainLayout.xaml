<Window xmlns="http://microsoft.com"
        xmlns:x="http://microsoft.com"
        Title="WinUtil Apex Core Toolkit" Height="680" Width="850" Background="#0F0F12" WindowStartupLocation="CenterScreen" ResizeMode="CanMinus">
    
    <!-- Custom Control Styling for Premium Look -->
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#16161F"/>
            <Setter Property="Foreground" Value="#8F90A6"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A1A26"/>
                    <Setter Property="Foreground" Value="#00FFFF"/>
                    <Setter Property="BorderBrush" Value="#7928CA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F1F2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D2D3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/> <!-- Live GUI Logging Window -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BANNER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="WINUTIL APEX CORE" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Next-Gen Deployment, Bloatware Decimation &amp; System Optimization Matrix" FontSize="11" Foreground="#6B6C7E" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Background="#FF007A" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4" CornerRadius="4">
                <TextBlock Text="PRO FORK v2.0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
            </Border>
        </Grid>

        <!-- MAIN MATRIX CONTROLLER HOUSING -->
        <TabControl Grid.Row="1" Background="#16161F" BorderBrush="#2D2D3F" BorderThickness="1">
            
            <!-- TAB 1: MODULAR APP APEX DISPATCHER -->
            <TabItem Header="  SOFTWARE INSTANCE SUITE  ">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 1: WEB NAVIGATORS -->
                            <StackPanel Grid.Column="0" Margin="5" Spacing="10">
                                <Border Background="#1F1F2E" Padding="8" CornerRadius="4" Margin="0,0,0,5">
                                    <TextBlock Text="🌐 BROWSERS" Foreground="#00FFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <CheckBox Name="AppChrome" Content="Google Chrome" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppBrave" Content="Brave Browser" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppFirefox" Content="Mozilla Firefox" Foreground="#E1E1E6"/>
                            </StackPanel>

                            <!-- COLUMN 2: POWER UTILITIES -->
                            <StackPanel Grid.Column="1" Margin="5" Spacing="10">
                                <Border Background="#1F1F2E" Padding="8" CornerRadius="4" Margin="0,0,0,5">
                                    <TextBlock Text="🛠️ UTILITIES" Foreground="#FF007A" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <CheckBox Name="App7Zip" Content="7-Zip Archiver" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppTerminal" Content="Windows Terminal" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppPowerToys" Content="MS PowerToys" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppBleach" Content="BleachBit (Clean)" Foreground="#E1E1E6"/>
                            </StackPanel>

                            <!-- COLUMN 3: ENGINE DEVELOPMENT -->
                            <StackPanel Grid.Column="2" Margin="5" Spacing="10">
                                <Border Background="#1F1F2E" Padding="8" CornerRadius="4" Margin="0,0,0,5">
                                    <TextBlock Text="💻 DEV &amp; DESIGN" Foreground="#7928CA" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <CheckBox Name="AppVSC" Content="VS Code Studio" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppGit" Content="Git Deployment" Foreground="#E1E1E6"/>
                                <CheckBox Name="AppNotepad" Content="Notepad++" Foreground="#E1E1E6"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Button Name="BtnInstallGroup" Grid.Row="1" Content="🚀 DEPLOY SELECTED CORE PIPELINE" Background="#7928CA" Foreground="#FFFFFF" Height="45" FontSize="14" FontWeight="Bold" Margin="0,15,0,0" BorderThickness="0"/>
                </Grid>
            </TabItem>

            <!-- TAB 2: SYSTEM CORRECTION & OPTIMIZATION MATRIX -->
            <TabItem Header="  PERFORMANCE &amp; TWEAKS  ">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: PRESET MACROS -->
                    <StackPanel Grid.Column="0" Margin="5" Spacing="12">
                        <TextBlock Text="⚡ QUICK-ACTION AUTOMATION PRESETS" Foreground="#00FFFF" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Button Name="PresetPerformance" Content="🏎️ MAX PERFORMANCE (Disable Limits / Speed Boost)" Height="40" Background="#252538"/>
                        <Button Name="PresetPrivacy" Content="🔒 ULTIMATE PRIVACY DEEP-TWEAK (Max Isolation)" Height="40" Background="#252538"/>
                        <Button Name="PresetUndo" Content="🔄 REVERT SYSTEM CHANGES (Safety Rollback)" Height="40" Background="#3A2222" BorderBrush="#FF5555"/>
                    </StackPanel>

                    <!-- RIGHT PANEL: INDIVIDUAL ADVANCED OVERRIDES -->
                    <StackPanel Grid.Column="1" Margin="15,5,5,5" Spacing="10">
                        <TextBlock Text="⚙️ MICRO-MANAGEMENT SWITCHES" Foreground="#FF007A" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Button Name="TweakTelemetry" Content="🛡️ Strip Windows Telemetry &amp; AdvertID" HorizontalAlignment="Stretch"/>
                        <Button Name="TweakHibernation" Content="🔋 Disable Hibernation (Save 10GB+ Disk Space)" HorizontalAlignment="Stretch"/>
                        <Button Name="TweakUpdates" Content="🔄 Reschedule Windows Updates to Security Only" HorizontalAlignment="Stretch"/>
                        <Button Name="TweakStorage" Content="🧹 Purge Temporal Caches &amp; Logs" HorizontalAlignment="Stretch"/>
                        <Button Name="TweakDevMode" Content="🛠️ Configure Developer Environment (Developer Mode, Long Paths)" HorizontalAlignment="Stretch" Background="#1D2A3A" BorderBrush="#3D6A9A"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- INTERACTIVE LIVE SYSTEM CONSOLE OUTPUT -->
        <GroupBox Grid.Row="2" Header=" ENGINE REALTIME MONITOR PIPELINE " Foreground="#6B6C7E" FontSize="10" BorderBrush="#2D2D3F" Margin="0,15,0,0">
            <TextBox Name="TerminalMonitor" Background="#070709" Foreground="#00FF00" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Padding="8"/>
        </GroupBox>

        <!-- GLOBAL CONTROL STATUS BAR -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Name="GlobalStatus" Text="System State: Idle // Awaiting Matrix Input Execution Packet..." Foreground="#A0A0A6" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="Secure Build Sandbox Enabled" Foreground="#444444" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
